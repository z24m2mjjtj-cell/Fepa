# Anthropic API key for the EIN-trepreneur AI chat backend.
# Create one at https://console.anthropic.com/settings/keys
# Copy this file to .env and fill in the real key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Port the Express server listens on (optional, defaults to 3000).
PORT=3000

# Set when running behind a reverse proxy (Render, Fly, Railway, nginx) so the
# per-IP rate limit sees the real client address. Value is the number of proxy
# hops to trust, e.g. 1. Leave unset when the server is exposed directly.
# TRUST_PROXY=1
