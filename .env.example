# Copy this file to .env and fill in real values. Never commit .env.

# --- Chat -------------------------------------------------------------------
# Anthropic API key for the EIN-trepreneur AI chat backend.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Access tokens ----------------------------------------------------------
# Signs the lifetime access links emailed to buyers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every access link ever issued, which is also the
# only way to revoke one.
ACCESS_TOKEN_SECRET=

# --- Stripe -----------------------------------------------------------------
# Prefer a RESTRICTED key (rk_) over a secret key (sk_): grant it only
# "write" on Checkout Sessions and nothing else, so a leak can't refund,
# read customers, or move money. https://docs.stripe.com/keys
# In production, store this in your platform's secrets vault rather than a
# committed env file. Never put a live key in source.
STRIPE_SECRET_KEY=rk_test_...

# Signing secret for the checkout.session.completed webhook. Get it from
# https://dashboard.stripe.com/webhooks after pointing a webhook endpoint at
# https://your-domain/api/stripe/webhook — or, locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email ------------------------------------------------------------------
# SMTP credentials used to send access links. Works with any provider
# (Postmark, SES, Resend, Fastmail, Gmail app passwords, ...).
# With these unset the server logs the access link instead of emailing it, so
# a purchase is still recoverable by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FEPA LLC <no-reply@your-domain>

# --- Server -----------------------------------------------------------------
# Public origin, used to build Stripe redirect URLs and emailed access links.
# Required in production; falls back to the request's own host when unset.
SITE_URL=https://your-domain

# Port the Express server listens on (optional, defaults to 3000).
PORT=3000

# Set when running behind a reverse proxy (Render, Fly, Railway, nginx) so the
# per-IP rate limit sees the real client address. Value is the number of proxy
# hops to trust, e.g. 1. Leave unset when the server is exposed directly.
# TRUST_PROXY=1
